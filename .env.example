# BrainGenius environment configuration (copy to .env or export in your shell)

# Port the server listens on (default 3000)
PORT=3000

# Secret used to sign login tokens. Use a long random string in production.
# If left unset, a development-only fallback is used and a warning is printed.
JWT_SECRET=change-me-to-a-long-random-string

# Optional admin account, created on first run only if BOTH are set.
# There is deliberately no built-in default admin password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
